# Local state only. Copy intentionally; Project_Supervisor does not auto-load this file.
PROJECT_SUPERVISOR_DATA_DIR=/absolute/path/to/private/local/state
PROJECT_SUPERVISOR_HOST=127.0.0.1
PROJECT_SUPERVISOR_PORT=7330
PROJECT_SUPERVISOR_READ_ONLY_API=true
PROJECT_SUPERVISOR_PRIVATE_TRANSPORT=false
PROJECT_SUPERVISOR_LOG_LEVEL=INFO

# Non-loopback operation is rejected unless private transport AND TLS are configured.
# Do not commit real certificate/key paths or credentials.
# PROJECT_SUPERVISOR_TLS_CERTIFICATE=/absolute/private/path/server.crt
# PROJECT_SUPERVISOR_TLS_PRIVATE_KEY=/absolute/private/path/server.key
