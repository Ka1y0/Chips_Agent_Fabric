{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chips-agent-fabric.invalid/schemas/bridge-support-accounting-v1.schema.json",
  "title": "Bridge support accounting v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exchangeID", "counts", "contributions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "exchangeID": {"type": "string", "minLength": 1},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transmitted", "prior", "synergistic", "invented", "contradicted"],
      "properties": {
        "transmitted": {"type": "integer", "minimum": 0},
        "prior": {"type": "integer", "minimum": 0},
        "synergistic": {"type": "integer", "minimum": 0},
        "invented": {"type": "integer", "minimum": 0},
        "contradicted": {"type": "integer", "minimum": 0}
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitID", "category", "sourceIDs", "confidence"],
        "properties": {
          "unitID": {"type": "string", "minLength": 1},
          "category": {
            "enum": ["transmitted", "prior", "synergistic", "invented", "contradicted"]
          },
          "sourceIDs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
