{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chips-agent-fabric.invalid/schemas/bootstrap-plan-v2.schema.json",
  "title": "CHIPS Agent Fabric Bootstrap Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "milestone", "mode", "supportedPlatform", "failClosed", "steps",
    "automaticActions", "prohibitedAutomaticActions"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "milestone": {"const": "universal-bootstrap-lifecycle-foundation"},
    "mode": {"const": "dryRun"},
    "supportedPlatform": {"type": "boolean"},
    "failClosed": {"const": true},
    "automaticActions": {"type": "array", "maxItems": 0},
    "prohibitedAutomaticActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "phase", "action", "status", "reason", "mutating", "dependsOn",
          "requiredCapability"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "phase": {
            "enum": ["DISCOVER", "REVIEW", "TRUST", "PREPARE", "CONFIGURE", "ENROLL", "VERIFY", "COMMIT"]
          },
          "action": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["ready", "notNeeded", "required", "approvalRequired", "blocked"]
          },
          "reason": {"type": "string", "minLength": 1},
          "mutating": {"type": "boolean"},
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "requiredCapability": {
            "type": ["string", "null"],
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
          },
          "candidates": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aiCLIs", "modelServers"],
            "properties": {
              "aiCLIs": {"type": "array", "items": {"type": "string"}},
              "modelServers": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
