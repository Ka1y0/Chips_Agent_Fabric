{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chips-agent-fabric.invalid/schemas/node-runtime-adapter-v1.schema.json",
  "title": "CHIPS Agent Fabric Typed Node Runtime Recovery Adapter Exchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["descriptor", "request", "result"],
  "properties": {
    "descriptor": {"$ref": "#/$defs/descriptor"},
    "request": {"$ref": "#/$defs/request"},
    "result": {"$ref": "#/$defs/result"}
  },
  "$defs": {
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterID", "nodeID", "protocolVersion", "maxOperationSeconds",
        "allowedOperations", "allowsArbitraryCommands", "enforcesFencing",
        "enforcesDeadline", "enforcesIdempotency"
      ],
      "properties": {
        "adapterID": {"type": "string", "minLength": 1, "maxLength": 160},
        "nodeID": {"type": "string", "minLength": 1, "maxLength": 160},
        "protocolVersion": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"},
        "maxOperationSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
        "allowedOperations": {
          "type": "array",
          "const": ["runtime.start"]
        },
        "allowsArbitraryCommands": {"const": false},
        "enforcesFencing": {"const": true},
        "enforcesDeadline": {"const": true},
        "enforcesIdempotency": {"const": true}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoveryID", "policyID", "nodeID", "runtimeID", "operation",
        "backendEndpoint", "authorizationRef", "leaseOwnerID", "leaseGeneration",
        "idempotencyKey", "requestedAt", "deadlineAt"
      ],
      "properties": {
        "recoveryID": {"type": "string", "minLength": 1},
        "policyID": {"type": "string", "minLength": 1},
        "nodeID": {"type": "string", "minLength": 1},
        "runtimeID": {"type": "string", "minLength": 1},
        "operation": {"const": "runtime.start"},
        "backendEndpoint": {
          "type": "string",
          "allOf": [
            {"pattern": "^https?://(?:127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+/?$"},
            {"not": {"pattern": "[\\r\\n\\u2028\\u2029]"}}
          ]
        },
        "authorizationRef": {"type": "string", "pattern": "^(?:grant|approval|capability)-[A-Za-z0-9._:-]{1,140}$"},
        "leaseOwnerID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:@/-]{0,159}$"},
        "leaseGeneration": {"type": "integer", "minimum": 1},
        "idempotencyKey": {"type": "string", "minLength": 1},
        "requestedAt": {"type": "string", "format": "date-time"},
        "deadlineAt": {"type": "string", "format": "date-time"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted", "operationReference", "detail", "observedFencingGeneration",
        "idempotentReplay"
      ],
      "properties": {
        "accepted": {"type": "boolean"},
        "operationReference": {"type": ["string", "null"]},
        "detail": {"type": ["string", "null"]},
        "observedFencingGeneration": {"type": ["integer", "null"], "minimum": 1},
        "idempotentReplay": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"accepted": {"const": true}}},
          "then": {
            "properties": {
              "operationReference": {"type": "string", "minLength": 1},
              "observedFencingGeneration": {"type": "integer", "minimum": 1}
            }
          }
        }
      ]
    }
  }
}
