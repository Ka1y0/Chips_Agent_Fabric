{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chips:fabric:node-enrollment-bundle:v1",
  "title": "Node Enrollment Bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enrollmentID",
    "generation",
    "issuedAt",
    "expiresAt",
    "requestSHA256",
    "expectedHost",
    "artifact",
    "serviceProfile",
    "controlPlaneIdentity",
    "requestedInitialCapabilities",
    "authorizationScope",
    "credential"
  ],
  "properties": {
    "schemaVersion": {"const": "node-enrollment-bundle/v1"},
    "enrollmentID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
    "generation": {"type": "integer", "minimum": 1},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "requestSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expectedHost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostName",
        "tailscalePeerIdentity",
        "tailscaleServeURL",
        "machineBindingSHA256",
        "platform",
        "architecture",
        "windowsBuild"
      ],
      "properties": {
        "hostName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$"},
        "tailscalePeerIdentity": {"type": "string", "minLength": 1, "maxLength": 512},
        "tailscaleServeURL": {"type": "string", "format": "uri", "pattern": "^https://"},
        "machineBindingSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "platform": {"const": "windows"},
        "architecture": {"const": "x64"},
        "windowsBuild": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactID", "sha256", "manifestSHA256", "sourceSnapshotSHA256"],
      "properties": {
        "artifactID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifestSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sourceSnapshotSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "serviceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileID", "revision", "sha256"],
      "properties": {
        "profileID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
        "revision": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "controlPlaneIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeID", "keyID", "publicKeyFingerprint"],
      "properties": {
        "nodeID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
        "keyID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
        "publicKeyFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "requestedInitialCapabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"}
    },
    "authorizationScope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"}
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "authModel", "rawSecretIncluded"],
      "properties": {
        "reference": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
        "authModel": {"const": "shared-bearer-hmac/v1"},
        "rawSecretIncluded": {"const": false}
      }
    }
  }
}
