{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chips:fabric:windows-node-enrollment-receipt:v1",
  "title": "Windows Node Enrollment Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enrollmentID",
    "hostName",
    "fabricNodeID",
    "tailscalePeerIdentity",
    "machineBindingSHA256",
    "platform",
    "architecture",
    "windowsBuild",
    "brokerProtocolVersion",
    "brokerRuntimeVersion",
    "brokerRuntimeProfileSHA256",
    "brokerTargetServiceConfigSHA256",
    "authorityID",
    "registryID",
    "runtimeInstanceID",
    "serviceProfileID",
    "serviceProfileRevision",
    "serviceProfileSHA256",
    "artifactSHA256",
    "manifestSHA256",
    "credentialProvisioned",
    "localAuthenticatedHealth",
    "tailnetAuthenticatedHealth",
    "scmAcceptance",
    "serviceRestartAcceptance",
    "advertisedCapabilities",
    "createdAt",
    "proofHMACSHA256"
  ],
  "properties": {
    "schemaVersion": {"const": "windows-node-enrollment-receipt/v1"},
    "enrollmentID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
    "hostName": {"type": "string", "minLength": 1, "maxLength": 253},
    "fabricNodeID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
    "tailscalePeerIdentity": {"type": "string", "minLength": 1, "maxLength": 512},
    "machineBindingSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "platform": {"const": "windows"},
    "architecture": {"const": "x64"},
    "windowsBuild": {"type": "string", "minLength": 1, "maxLength": 128},
    "brokerProtocolVersion": {"type": "string", "minLength": 1, "maxLength": 128},
    "brokerRuntimeVersion": {"type": "string", "minLength": 1, "maxLength": 128},
    "brokerRuntimeProfileSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "brokerTargetServiceConfigSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorityID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
    "registryID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
    "runtimeInstanceID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
    "serviceProfileID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"},
    "serviceProfileRevision": {"type": "integer", "minimum": 1},
    "serviceProfileSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifestSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "credentialProvisioned": {"const": true},
    "localAuthenticatedHealth": {"const": "passed"},
    "tailnetAuthenticatedHealth": {"const": "passed"},
    "scmAcceptance": {"const": "passed"},
    "serviceRestartAcceptance": {"const": "passed"},
    "advertisedCapabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"}
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "proofHMACSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
